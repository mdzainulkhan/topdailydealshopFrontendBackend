# Amazon Creators API (server-side only — never prefix with NEXT_PUBLIC_)
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
# Credential version 3.1 = NA, 3.2 = EU (India), 3.3 = FE. Version only decides the token URL.
AMAZON_CREDENTIAL_VERSION=3.2
AMAZON_TOKEN_URL=https://api.amazon.co.uk/auth/o2/token
AMAZON_MARKETPLACE=www.amazon.in
# Your Associates store/tracking ID (e.g. yourtag-21)
AMAZON_PARTNER_TAG=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
